@using BlazorApp1.Models
@inject BlazorApp1.Services.CartService Cart

<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <img class="card-img-top" src=@($"data:image/jpeg;base64,{@Product.ImageBase64}") alt="@Product.Name" />
        <h5 class="card-title">@Product.Name</h5>
        <p class="card-text text-muted">@Product.Description</p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <strong>@Product.Price.ToString("C")</strong>
            <button class="btn btn-primary" @onclick="AddToCart" disabled="@IsOutOfStock">Add</button>
        </div>
        @if (IsOutOfStock)
        {
            <small class="text-danger">Out of stock</small>
        }
    </div>
</div>


@code {
    [Parameter] public Product Product { get; set; } = default!;


    private bool IsOutOfStock => Product.Stock <= 0;


    private void AddToCart()
    {
        Cart.Add(Product, 1);
    }
}